---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostRow from "../../components/PostRow.astro";
import { getCategories, getPosts } from "../../lib/wordpress";

Astro.response.headers.set("Cache-Control", "public, max-age=60, s-maxage=60");
const [allPosts, categories] = await Promise.all([getPosts(), getCategories()]);
const category = categories.find((item) => item.slug === Astro.params.slug);
if (!category) return Astro.redirect("/404", 302);
const posts = allPosts.filter((post) => post.category.slug === category.slug);
---
<BaseLayout title={`${category.name} — নীলখাতা`} description={`${category.name} বিষয়ের সকল লেখা`}>
  <main id="top" class="listing">
    <div class="section-heading"><div><p class="eyebrow">বিষয়</p><h1>{category.name}</h1></div><span>{posts.length}টি লেখা</span></div>
    <div class="post-list">{posts.map((post, index) => <PostRow post={post} index={index + 1} />)}</div>
  </main>
</BaseLayout>
