---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPosts, type Post } from "../../lib/wordpress";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

interface Props { post: Post }
const { post } = Astro.props;
const date = new Intl.DateTimeFormat("bn-BD", { day: "numeric", month: "long", year: "numeric" }).format(new Date(post.date));
---
<BaseLayout title={`${post.title} — নীলখাতা`} description={post.excerpt} image={post.image}>
  <main id="top">
    <article class="article">
      <header class="article-header">
        <p class="kicker">{post.category.name} · {post.readingMinutes} মিনিটের পাঠ</p>
        <h1>{post.title}</h1>
        <p class="article-excerpt">{post.excerpt}</p>
        <div class="byline">{post.author} · <time datetime={post.date}>{date}</time></div>
      </header>
      {post.image && <figure class="article-image"><img src={post.image} alt={post.imageAlt || post.title}></figure>}
      <div class="article-content" set:html={post.content}></div>
      <footer class="article-footer"><a href={`/category/${post.category.slug}/`}>{post.category.name}</a></footer>
    </article>
  </main>
</BaseLayout>
