---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="পরিচয় — নীলখাতা" description="নীলখাতা ও এর লেখকের পরিচয়।">
  <main id="top">
    <article class="article about">
      <header class="article-header"><p class="eyebrow">পরিচয়</p><h1>একটি খাতা,<br>একজন কৌতূহলী মানুষ।</h1></header>
      <div class="article-content">
        <p>আমি আরিফ। নকশা করি, শহরের পথে হাঁটি, বইয়ের পাশে ছোট ছোট নোট লিখি। নীলখাতা সেই নোটগুলোরই একটু গোছানো বাড়ি।</p>
        <h2>কী নিয়ে লিখি</h2>
        <p>শহর ও স্মৃতি, বাংলা নকশা, প্রযুক্তি, বই এবং দূরের পথ—যেসব বিষয় দৈনন্দিন জীবনের দিকে নতুন করে তাকাতে শেখায়।</p>
        <h2>যোগাযোগ</h2>
        <p>কোনো লেখা নিয়ে কথা বলতে বা একসঙ্গে কাজের প্রস্তাব দিতে ইমেইল করুন: <a href="mailto:hello@example.com">hello@example.com</a></p>
      </div>
    </article>
  </main>
</BaseLayout>
